# Copy to .env and fill in. All settings are optional except where noted.

# --- core ---
BASE_URL=http://localhost:8000          # public URL, used in magic links (https => Secure cookies)
SECRET_KEY=change-me-to-a-long-random-string   # REQUIRED in production (signs cookies and links)
DATA_DIR=./data                         # uploads, outputs and the SQLite database
# DATABASE_URL=sqlite:///./data/app.db

# --- translation ---
TRANSLATION_PROVIDER=mock               # "google" or "mock" (mock = fixed sample text, no API key)
GOOGLE_TRANSLATE_API_KEY=

# --- limits & credits ---
CREDITS_PER_PAGE=10
FREE_SAMPLE_PAGES=2
MAX_UPLOAD_MB=25
MAX_PAGES=50
JOBS_PER_HOUR=10
DOWNLOAD_URL_TTL_SECONDS=3600
OUTPUT_RETENTION_DAYS=7
UPLOAD_RETENTION_HOURS=24               # unused uploads (e.g. after a free sample) are removed after this

# --- Razorpay (Basic Plan) ---
PLAN_NAME=Basic Plan
PLAN_PRICE_INR=649
PLAN_CREDITS=1000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- email (magic links). If SMTP_HOST is empty, links are printed to the server log. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Infinity Translate <no-reply@example.com>
SMTP_STARTTLS=true
